# Exclusivamente no SERVIDOR de backup, NUNCA em VITE_* ou frontend
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INSIRA_APENAS_NO_SERVIDOR
PGHOST=SEU_HOST_POSTGRESQL
PGPORT=5432
PGDATABASE=postgres
PGUSER=SEU_USUARIO_COM_PERMISSAO_DE_DUMP
PGPASSWORD=SENHA_DO_BANCO_APENAS_NO_SERVIDOR
PGSSLMODE=require
# Execute em ambiente com disco temporário criptografado. Tenha pg_dump e pg_restore compatíveis instalados.
